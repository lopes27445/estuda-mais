rules_version = '2';

// ============================================================================
// Estuda+ — regras de segurança do Firestore
//
// ATENÇÃO: estas regras valem para o PROJETO INTEIRO (painel-e5373), ou seja
// para o lab (painel-e5373-lab2.web.app) E para o beta (painel-e5373.web.app)
// ao mesmo tempo. Um deploy daqui muda os dois ambientes.
//
// Revisão de 23/08/2026 — fecha V-01, V-03, V-11 e metade da V-02 da auditoria.
// Continuam ABERTAS e documentadas em Estuda+/Auditoria de Segurança.md:
//   V-10 e-mail mestre hardcoded (precisa de custom claim = backend)
//   V-01 parcial: coordenação ainda escreve staff direto do navegador; o ideal
//        é só via Admin SDK com auditoria, o que exige Cloud Functions.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // E-mail confirmado. Login com Google já vem verificado; conta de e-mail e
    // senha só depois de clicar no link de confirmação.
    // V-02: sem isto, alguém cria uma conta de senha usando o e-mail de um
    // professor ANTES dele e herda o cargo no primeiro login.
    function verificado() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // V-03: enquanto existe UMA escola, prender o id aqui resolve o
    // atravessamento entre escolas por completo e não custa nenhuma leitura.
    // Quando entrar a segunda escola, isto vira consulta a
    // schools/{escola}/members/{uid} — que é o desenho pedido na auditoria.
    function escolaConhecida(escola) {
      return escola == 'coc-atibaia';
    }

    // V-10 (dívida conhecida): endereço fixo no código. Sai quando existir
    // custom claim emitida por servidor. É o único caminho de recuperação se
    // o documento de coordenação for apagado por engano — por isso fica.
    function ehMaster() {
      return verificado() && myEmail() == 'luizanthonylopes@gmail.com';
    }

    function staffDoc(escola) {
      return /databases/$(database)/documents/schools/$(escola)/staff/$(myEmail());
    }

    function ehStaff(escola) {
      return verificado() && escolaConhecida(escola)
             && (ehMaster() || exists(staffDoc(escola)));
    }

    // V-01: a regra antiga tratava todo staff como um grupo só, e por isso
    // qualquer professor conseguia se promover, cadastrar terceiros ou remover
    // a coordenação. Agora o papel é lido do próprio documento.
    function ehCoord(escola) {
      return verificado() && escolaConhecida(escola)
             && (ehMaster()
                 || (exists(staffDoc(escola))
                     && get(staffDoc(escola)).data.role == 'coordenacao'));
    }

    /* --------------------------- perfil do aluno ------------------------ */
    // V-11: antes era um wildcard `users/{uid}/{document=**}` com write livre,
    // então o próprio aluno podia gravar role:"coordenacao" no seu perfil.
    //
    // Nota sobre `affectedKeys` em vez de `keys`: perfis criados pelo cliente
    // antigo JÁ têm `role` e `schoolId` gravados. Uma regra sobre keys() do
    // documento inteiro rejeitaria toda atualização futura desses perfis e
    // travaria o app. affectedKeys() olha só o que MUDOU — o campo velho fica
    // lá, inerte, e ninguém consegue alterá-lo.

    function camposPerfil() {
      return ['email', 'nome', 'serie', 'turma', 'vestibulares'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(camposPerfil());
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(camposPerfil());
      allow delete: if false;
    }

    // Dados dos painéis (notas, estudos, vestibular): só o dono, e só no
    // formato { blob, updatedAt } que o cliente realmente grava.
    match /users/{uid}/panels/{painel} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['blob', 'updatedAt']);
      allow delete: if false;
    }

    /* ------------------------------ staff ------------------------------- */
    // Leitura: cada um lê o PRÓPRIO documento — é assim que o app descobre o
    // papel no login (computeRole em cloud.js). A coordenação lê a lista toda
    // para a tela de gestão. Aluno não enumera mais os e-mails dos professores.
    //
    // Escrita: SÓ coordenação. Esta linha é a correção da V-01.
    match /schools/{escola}/staff/{email} {
      allow read: if signedIn() && escolaConhecida(escola)
                  && (email == myEmail() || ehCoord(escola));
      allow write: if ehCoord(escola);
    }

    /* ------------------- calendário publicado pela escola ---------------- */
    // Aluno logado da escola lê; só staff verificado publica.
    match /schools/{escola}/series/{serie}/provas/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow write: if ehStaff(escola);
    }
    match /schools/{escola}/series/{serie}/pc/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow write: if ehStaff(escola);
    }
    match /schools/{escola}/series/{serie}/meta/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow write: if ehStaff(escola);
    }

    /* ------------------------ resumo de risco (opt-in) ------------------- */
    // Dado pedagógico sensível: só staff lê, e o aluno só escreve o próprio,
    // na própria escola e na própria série (antes dava para gravar em
    // qualquer caminho de escola/série — parte da V-03).
    // O `delete` do dono existe para permitir a revogação de consentimento
    // (V-05); o botão que chama isso ainda não foi construído.
    match /schools/{escola}/series/{serie}/risco/{uid} {
      allow read: if ehStaff(escola);
      allow create, update: if signedIn() && escolaConhecida(escola)
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(
                                 ['nome', 'email', 'serie', 'turma', 'pctMeta',
                                  'materias', 'atualizado'])
                            && request.resource.data.serie == serie;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    /* ------------------------------ mural -------------------------------- */
    // Ganho parcial da V-09: tirado o 'murals-lab' (nenhuma página usa) e
    // fechado o formato do post. A migração do mural para dentro de
    // schools/{escola}/ continua pendente e está na nota de auditoria.
    function ehMural(col) {
      return col == 'murals' || col == 'murals-lab2';
    }
    match /{col}/{itemId}/posts/{postId} {
      allow read: if signedIn() && ehMural(col);
      allow create: if signedIn() && ehMural(col)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['tipo', 'url', 'label', 'texto', 'uid', 'nome', 'createdAt']);
      allow delete: if signedIn() && ehMural(col)
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
