rules_version = '2';

// ============================================================================
// Estuda+ — regras de segurança do Firestore
//
// ATENÇÃO: estas regras valem para o PROJETO INTEIRO (painel-e5373), ou seja
// para o lab (painel-e5373-lab2.web.app) E para o beta (painel-e5373.web.app)
// ao mesmo tempo. Um deploy daqui muda os dois ambientes.
//
// Revisão de 23/08/2026 — fecha V-01, V-03, V-11 e metade da V-02 da auditoria.
//
// Revisão de 05/09/2026 — fecha os dois pontos em que a TELA dizia uma coisa e
// a REGRA permitia outra. Eram os dois itens que a proposta comercial já
// afirmava como verdade:
//   1. escopo do professor: `salas/{sala}/alunos` e `risco` liberavam para
//      QUALQUER staff. Um professor lia o nome e o e-mail de todos os alunos
//      de todas as salas, e o resumo de risco de todas as séries. A tela
//      filtrava; o banco não. Agora professor lê só as salas do escopo dele.
//   2. exclusão de dados: `allow delete: if false` em users/{uid} e nos
//      painéis significava que NINGUÉM apagava — nem o dono, nem a
//      coordenação. Sem isso não existe atendimento a pedido de exclusão
//      (LGPD art. 18), que a proposta afirma existir.
// Junto: B2 (aposenta o opt-in de risco) e D1 (trilha de mudança de faixa).
//
// Revisão de 25/09/2026 — V-16: valores com tipo e tamanho (antes só a LISTA
// de campos era fechada), ids sem caractere que feche atributo HTML, pedido de
// matrícula coerente com a sala e com o e-mail do token. Motivo concreto: um
// aluno gravava `medias` como texto com <img onerror> e o script rodava na
// tela da coordenação.
//
// ATENÇÃO — em 25/09/2026 o que estava PUBLICADO era a versão de 26/08 (289
// linhas): nada das revisões de 05/09 e 22/09 tinha ido ao ar. Antes de
// confiar que uma correção daqui vale, rode `node tools/confere-regras.mjs`.
//
// Continuam ABERTAS e documentadas em Estuda+/Auditoria de Segurança.md:
//   V-01 parcial: coordenação ainda escreve staff direto do navegador; o ideal
//        é só via Admin SDK com auditoria, o que exige Cloud Functions.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // E-mail confirmado. Login com Google já vem verificado; conta de e-mail e
    // senha só depois de clicar no link de confirmação.
    // V-02: sem isto, alguém cria uma conta de senha usando o e-mail de um
    // professor ANTES dele e herda o cargo no primeiro login.
    function verificado() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // V-03: enquanto existe UMA escola, prender o id aqui resolve o
    // atravessamento entre escolas por completo e não custa nenhuma leitura.
    // Quando entrar a segunda escola, isto vira consulta a
    // schools/{escola}/members/{uid} — que é o desenho pedido na auditoria.
    function escolaConhecida(escola) {
      return escola == 'coc-atibaia';
    }

    // V-10 completa (25/09/2026): o poder de dono vem SÓ da custom claim
    // `admin`, que apenas o Admin SDK grava (tools/set-admin-claim.mjs).
    // O e-mail fixo que ficava aqui ao lado saiu depois de conferido no
    // próprio Firebase que a claim está na conta do dono (customClaims
    // {admin:true}, e-mail verificado, login Google).
    // Devolver ou tirar o poder:  node tools/set-admin-claim.mjs <e-mail> [--tirar]
    // A claim só aparece num token renovado — sair e entrar de novo no app.
    function temClaimAdmin() {
      return request.auth.token.get('admin', false) == true;
    }
    function ehMaster() {
      return verificado() && temClaimAdmin();
    }

    function staffDoc(escola) {
      return /databases/$(database)/documents/schools/$(escola)/staff/$(myEmail());
    }

    function ehStaff(escola) {
      return verificado() && escolaConhecida(escola)
             && (ehMaster() || exists(staffDoc(escola)));
    }

    // V-01: a regra antiga tratava todo staff como um grupo só, e por isso
    // qualquer professor conseguia se promover, cadastrar terceiros ou remover
    // a coordenação. Agora o papel é lido do próprio documento.
    function ehCoord(escola) {
      return verificado() && escolaConhecida(escola)
             && (ehMaster()
                 || (exists(staffDoc(escola))
                     && get(staffDoc(escola)).data.role == 'coordenacao'));
    }

    // `users/{uid}` mora FORA de `schools/{escola}/`, então não há variável de
    // escola no caminho para passar adiante. Enquanto existe uma escola só, o
    // id é constante — é a mesma premissa que `escolaConhecida()` já assume.
    // Quando entrar a segunda escola, isto vira consulta ao documento de
    // membro do aluno, junto com o resto da multi-tenancy.
    function ehCoordDaEscolaUnica() {
      return ehCoord('coc-atibaia');
    }

    /* --------------------------- perfil do aluno ------------------------ */
    // V-11: antes era um wildcard `users/{uid}/{document=**}` com write livre,
    // então o próprio aluno podia gravar role:"coordenacao" no seu perfil.
    //
    // Nota sobre `affectedKeys` em vez de `keys`: perfis criados pelo cliente
    // antigo JÁ têm `role` e `schoolId` gravados. Uma regra sobre keys() do
    // documento inteiro rejeitaria toda atualização futura desses perfis e
    // travaria o app. affectedKeys() olha só o que MUDOU — o campo velho fica
    // lá, inerte, e ninguém consegue alterá-lo.

    function camposPerfil() {
      return ['email', 'nome', 'serie', 'turma', 'vestibulares'];
    }

    /* V-16 (25/09/2026): as regras fechavam QUAIS campos, nunca o que vai
       DENTRO deles. `nome` podia ser um texto de 1 MB, `serie` um objeto,
       `medias` uma string com <img onerror>. Era por aí que o XSS das médias
       chegava à tela da coordenação. Agora cada valor escrito pelo navegador
       tem tipo e tamanho.

       `ks` = as chaves a validar. No create são todas; no update só as que
       MUDARAM — um perfil antigo com valor fora do padrão continua podendo ser
       atualizado nos outros campos, e o valor ruim não pode ser reescrito. */
    function textoAte(v, n) {
      return v is string && v.size() <= n;
    }
    function idSeguro(id) {
      // formato dos ids automáticos do Firestore, com folga. Sem aspas, sem
      // espaço: o id vai parar dentro de atributo HTML no cliente.
      return id.matches('^[A-Za-z0-9_-]{1,64}$');
    }
    function perfilOk(d, ks) {
      return (!('nome' in ks) || textoAte(d.nome, 120))
          && (!('email' in ks) || textoAte(d.email, 254))
          && (!('serie' in ks) || d.serie in ['1', '2', '3'])
          && (!('turma' in ks) || textoAte(d.turma, 3))
          && (!('vestibulares' in ks) || (d.vestibulares is list && d.vestibulares.size() <= 3));
    }

    /* Exclusão (LGPD art. 18). Antes era `allow delete: if false` aqui e nos
       painéis — ou seja, NINGUÉM apagava: nem o próprio aluno, nem a
       coordenação, nem o dono do sistema. Um aluno que saísse da escola ficava
       na base para sempre, e não havia como atender um pedido de exclusão.

       Quem pode apagar, e por quê:
       - o DONO, porque o direito é dele;
       - a COORDENAÇÃO, porque é a escola que RECEBE o pedido (ela é a
         controladora; o Estuda+ é operador) e porque o aluno que já saiu
         costuma nunca mais abrir o app — sem este caminho o pedido dela ficaria
         sem resposta possível.

       Repare que a coordenação apaga sem poder LER: o `read` continua só do
       dono. É de propósito — atender exclusão não exige ver o conteúdo, e dar
       leitura junto seria ampliar poder sem finalidade. */
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(camposPerfil())
                    && perfilOk(request.resource.data, request.resource.data.keys().toSet());
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(camposPerfil())
                    && perfilOk(request.resource.data,
                                request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if (signedIn() && request.auth.uid == uid)
                    || ehCoordDaEscolaUnica();
    }

    // Dados dos painéis (notas, estudos, vestibular): só o dono, e só no
    // formato { blob, updatedAt } que o cliente realmente grava.
    // A exportação (o outro direito do art. 18) não precisa de regra nova: o
    // dono já lê tudo isto, e é daqui que o botão "baixar meus dados" monta o
    // arquivo.
    match /users/{uid}/panels/{painel} {
      allow read: if signedIn() && request.auth.uid == uid;
      // V-16: nome de painel em lista fechada (antes qualquer conta criava
      // quantos documentos quisesse sob o próprio uid, com qualquer nome) e
      // blob sempre um mapa. Os nomes são os do env.js: base + sufixo do lab.
      allow create, update: if signedIn() && request.auth.uid == uid
                            && painel.matches('^(notas|estudos|vestibular)(-lab[0-9]*)?$')
                            && request.resource.data.keys().hasOnly(['blob', 'updatedAt'])
                            && request.resource.data.blob is map
                            && request.resource.data.updatedAt is number;
      allow delete: if (signedIn() && request.auth.uid == uid)
                    || ehCoordDaEscolaUnica();
    }

    /* ------------------------------ staff ------------------------------- */
    // Leitura: cada um lê o PRÓPRIO documento — é assim que o app descobre o
    // papel no login (computeRole em cloud.js). A coordenação lê a lista toda
    // para a tela de gestão. Aluno não enumera mais os e-mails dos professores.
    //
    // Escrita: SÓ coordenação. Esta linha é a correção da V-01.
    match /schools/{escola}/staff/{email} {
      allow read: if signedIn() && escolaConhecida(escola)
                  && (email == myEmail() || ehCoord(escola));
      // V-16: papel só entre os dois que existem, escopo como lista, e o id
      // do documento com cara de e-mail minúsculo (é comparado com o e-mail
      // do token, que o Firebase já entrega em minúsculas — um id com
      // maiúscula criava um cadastro que nunca casava com ninguém).
      allow create: if ehCoord(escola)
                    && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
                    && request.resource.data.keys().hasOnly(staffCampos())
                    && staffOk(request.resource.data, request.resource.data.keys().toSet())
                    && 'role' in request.resource.data;
      allow update: if ehCoord(escola)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffCampos())
                    && staffOk(request.resource.data,
                               request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if ehCoord(escola);
    }
    function staffCampos() {
      return ['role', 'addedBy', 'addedAt', 'materias', 'salas'];
    }
    function staffOk(d, ks) {
      return (!('role' in ks) || d.role in ['professor', 'coordenacao'])
          && (!('addedBy' in ks) || textoAte(d.addedBy, 254))
          && (!('addedAt' in ks) || d.addedAt is number)
          && (!('materias' in ks) || (d.materias is list && d.materias.size() <= 20))
          && (!('salas' in ks) || (d.salas is list && d.salas.size() <= 30));
    }

    /* ------------------- calendário publicado pela escola ---------------- */
    // Aluno logado da escola lê; só staff verificado publica.
    // V-16: o id do item vai para dentro de onclick="…" na tela de todos os
    // alunos da série. O admin só cria id automático; id com aspa é ataque.
    match /schools/{escola}/series/{serie}/provas/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow create, update: if ehStaff(escola) && idSeguro(doc);
      allow delete: if ehStaff(escola);
    }
    match /schools/{escola}/series/{serie}/pc/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow create, update: if ehStaff(escola) && idSeguro(doc);
      allow delete: if ehStaff(escola);
    }
    match /schools/{escola}/series/{serie}/meta/{doc} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow write: if ehStaff(escola);
    }

    /* -------------- resumo de risco — APOSENTADO (B2) -------------------- */
    // Este era o opt-in: o aluno clicava em 📤 para compartilhar a situação
    // dele com a escola. Duas razões para acabar, e a segunda só ficou
    // visível agora:
    //
    // 1. O mecanismo falhava exatamente onde importava. Quem está em risco é
    //    quem NÃO clica. Um alerta que depende do aluno em dificuldade tomar a
    //    iniciativa de se expor não é um alerta.
    //
    // 2. Era o segundo vazamento de escopo. `allow read: if ehStaff(escola)`
    //    dava a QUALQUER professor cadastrado o resumo de TODOS os alunos de
    //    TODAS as séries — e aqui não havia como consertar só a regra: `risco`
    //    mora em `series/{serie}/`, não em `salas/{sala}/`, então não existe
    //    sala no caminho para comparar com o escopo do professor. O dado
    //    estava guardado num formato que o modelo de escopo não expressa.
    //
    // O que substitui: a projeção do B1 logo abaixo, que carrega a mesma
    // informação e já nasce com escopo por sala e matéria.
    //
    // Por que a regra continua existindo em vez de sumir: ainda há documentos
    // gravados. Escrita nova está fechada; o que resta é poder apagá-los. O app
    // do aluno apaga o próprio na primeira abertura, e a coordenação tem um
    // botão para varrer o que sobrar. Quando a coleção estiver vazia, este
    // bloco inteiro sai.
    match /schools/{escola}/series/{serie}/risco/{uid} {
      // professor NÃO lê mais — era o vazamento. Só o dono e a coordenação,
      // e só para conseguir enxergar o que ainda precisa ser apagado.
      allow read: if signedIn() && escolaConhecida(escola)
                  && (request.auth.uid == uid || ehCoord(escola));
      allow create, update: if false;
      allow delete: if (signedIn() && request.auth.uid == uid) || ehCoord(escola);
    }

    /* ------------------- A1/A2: escopo do professor ----------------------- */
    // O staff passa a carregar `materias` e `salas`. Antes o papel era só
    // aluno/professor/coordenacao e não havia vínculo nenhum com o que a
    // pessoa realmente leciona — o campo de professor nas provas era texto
    // livre, não referência.
    //
    // A2 é a exceção deliberada: coordenação ignora o filtro e vê tudo.

    function staffInfo(escola) {
      return get(staffDoc(escola)).data;
    }
    function ehProfessorDe(escola, sala, materia) {
      return ehStaff(escola)
             && (sala in staffInfo(escola).get('salas', []))
             && (materia in staffInfo(escola).get('materias', []));
    }
    // Só a sala, sem a matéria: é o que a lista de alunos da turma precisa.
    // Um professor de Biologia da 3ªB continua vendo QUEM está na 3ªB — isso
    // é o trabalho dele. O que ele deixa de ver é a 3ªA, a 2ªC, etc.
    //
    // ATENÇÃO ao usar: chame sempre depois de `ehCoord(...)` num `||`. O
    // `staffInfo` faz get() no documento de staff, e a coordenação-mestre pode
    // não ter documento nenhum (o poder dela vem da claim/e-mail). Sem o
    // curto-circuito do ehCoord antes, a regra erraria em vez de liberar.
    function ehProfessorDaSala(escola, sala) {
      return ehStaff(escola) && (sala in staffInfo(escola).get('salas', []));
    }
    // lista canônica — a mesma de app/escola.js. Existe em duplicata de
    // propósito: a regra não pode importar o JS, e sem ela o cliente criaria
    // coleção com qualquer nome de matéria.
    function materiaValida(m) {
      return m in ['biologia', 'fisica', 'quimica', 'matematica', 'lingua-portuguesa',
                   'lingua-inglesa', 'geografia', 'historia', 'sociologia', 'filosofia'];
    }
    function alunoAprovado(escola, sala, uid) {
      return exists(/databases/$(database)/documents/schools/$(escola)/salas/$(sala)/alunos/$(uid))
             && get(/databases/$(database)/documents/schools/$(escola)/salas/$(sala)/alunos/$(uid))
                  .data.status == 'aprovado';
    }

    /* --------------- B1: professor vê as notas da matéria dele ------------ */
    // Projeção por matéria, escrita pelo navegador do próprio aluno — é o
    // único caminho possível sem backend, já que as notas cruas vivem num blob
    // privado que ninguém além do dono consegue ler.
    //
    // Consequência honesta, e por isso `atualizado` é obrigatório: o professor
    // vê a foto do último momento em que o aluno abriu o app, não o estado de
    // agora. A tela precisa mostrar essa data em vez de fingir que é ao vivo.
    match /schools/{escola}/salas/{sala}/materias/{materia}/notas/{uid} {
      allow read: if signedIn() && escolaConhecida(escola)
                  && (request.auth.uid == uid
                      || ehCoord(escola)
                      || ehProfessorDe(escola, sala, materia));

      allow create, update: if signedIn() && escolaConhecida(escola)
                            && request.auth.uid == uid
                            && materiaValida(materia)
                            && alunoAprovado(escola, sala, uid)
                            && request.resource.data.keys().hasOnly(
                                 ['nome', 'status', 'acc', 'precisa', 'fechou',
                                  'medias', 'atualizado'])
                            && request.resource.data.atualizado is number
                            // V-16: isto é lido na tela do PROFESSOR e da
                            // COORDENAÇÃO. `medias` como texto era o vetor do
                            // XSS contra quem tem poder de cadastrar staff.
                            && textoAte(request.resource.data.get('nome', ''), 120)
                            && request.resource.data.get('status', 'ok') in ['ok', 'atencao', 'risco']
                            && request.resource.data.get('acc', 0) is number
                            && request.resource.data.get('precisa', 0) is number
                            && request.resource.data.get('fechou', false) is bool
                            && request.resource.data.get('medias', []) is list
                            && request.resource.data.get('medias', []).size() <= 4;

      allow delete: if (signedIn() && request.auth.uid == uid) || ehCoord(escola);
    }

    /* ------------- D1: trilha de mudança de faixa (o alerta) -------------- */
    // O que o professor precisa saber não é "está em vermelho" — isso ele vê
    // na projeção acima. É "MUDOU para vermelho, e faz dois dias". Estado
    // parado não é notícia; a transição é. Por isso o que se grava aqui é o
    // par (de → para), e nunca se altera depois.
    //
    // Mesmo desenho e mesma honestidade da projeção: quem escreve é o
    // navegador do aluno, então o carimbo `quando` é o momento em que ELE
    // abriu o app, não o momento em que a nota mudou na secretaria.
    //
    // Escopo idêntico ao do B1 de propósito — a transição é tão sensível
    // quanto a nota que a gerou, e cair num escopo mais frouxo aqui
    // reabriria pela porta dos fundos o vazamento que o B2 acabou de fechar.
    match /schools/{escola}/salas/{sala}/materias/{materia}/transicoes/{id} {
      allow read: if signedIn() && escolaConhecida(escola)
                  && (request.auth.uid == resource.data.uid
                      || ehCoord(escola)
                      || ehProfessorDe(escola, sala, materia));

      allow create: if signedIn() && escolaConhecida(escola)
                    && request.auth.uid == request.resource.data.uid
                    && materiaValida(materia)
                    && alunoAprovado(escola, sala, request.auth.uid)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'nome', 'de', 'para', 'quando'])
                    && request.resource.data.de in ['ok', 'atencao', 'risco']
                    && request.resource.data.para in ['ok', 'atencao', 'risco']
                    && textoAte(request.resource.data.get('nome', ''), 120)
                    && idSeguro(id)
                    && request.resource.data.de != request.resource.data.para
                    && request.resource.data.quando is number;

      // append-only, como a trilha de auditoria: reescrever uma transição
      // depois seria reescrever o histórico que o professor usa para decidir.
      allow update: if false;

      // apagar existe pelo mesmo motivo do resto: pedido de exclusão de dados.
      allow delete: if (signedIn() && request.auth.uid == resource.data.uid)
                    || ehCoord(escola);
    }

    /* -------------------------------- salas ------------------------------ */
    // A0: a sala vira entidade, e a matrícula tem dono — o aluno PEDE, a
    // coordenação APROVA. Antes "turma" era uma letra que o próprio aluno
    // digitava, sem nada por trás e sem ninguém conferindo.

    function pedidoDeMatricula() {
      return ['nome', 'email', 'serie', 'turma', 'status', 'pedidoEm'];
    }
    /* V-16: o pedido é lido pela coordenação, que aprova olhando nome, e-mail
       e turma. Antes o aluno podia pedir a sala 3A escrevendo "1ª B" nos
       campos, ou colocar o e-mail de OUTRA pessoa no pedido — a coordenadora
       aprovaria alguém que não é quem parece. Agora: e-mail é o do token,
       e série/turma batem com o id da sala (mesma conta do Escola.salaId). */
    function pedidoCoerente(sala, d) {
      return textoAte(d.nome, 120)
          && d.email == request.auth.token.email
          && d.serie in ['1', '2', '3']
          && d.turma in ['A', 'B', 'C', 'D', '—']
          && sala == d.serie + (d.turma == '—' ? 'U' : d.turma)
          && d.pedidoEm is number;
    }

    match /schools/{escola}/salas/{sala} {
      allow read: if signedIn() && escolaConhecida(escola);
      allow write: if ehCoord(escola);
    }

    match /schools/{escola}/salas/{sala}/alunos/{uid} {
      // O aluno lê a própria matrícula (pra saber se já foi aprovado).
      //
      // CORREÇÃO DE 05/09/2026 — aqui estava `ehStaff(escola)`, que é só
      // "tem documento de staff" e não olha `salas`. Resultado: qualquer
      // professor cadastrado lia nome, e-mail, série e turma de TODOS os
      // alunos de TODAS as salas da escola. A tela filtrava certo, então nada
      // parecia quebrado — o vazamento só aparecia para quem abrisse o console
      // do navegador. Era o primeiro dos dois pontos em que a proposta
      // comercial afirmava um escopo que o banco não aplicava.
      //
      // O padrão correto já existia neste arquivo, na regra do B1 logo acima.
      // Agora vale aqui também: coordenação vê tudo (A2), professor vê as
      // salas do escopo dele.
      allow read: if signedIn() && escolaConhecida(escola)
                  && (request.auth.uid == uid
                      || ehCoord(escola)
                      || ehProfessorDaSala(escola, sala));

      // ESTA é a regra que sustenta o A0 inteiro: o aluno cria o PRÓPRIO
      // pedido e ele nasce obrigatoriamente 'pendente'. Ninguém entra numa
      // turma sozinho — é o mesmo princípio da V-01, aplicado a aluno.
      allow create: if signedIn() && escolaConhecida(escola)
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(pedidoDeMatricula())
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.serie is string
                    && request.resource.data.turma is string
                    && pedidoCoerente(sala, request.resource.data);

      // o aluno pode corrigir os próprios dados e reenviar o pedido, mas
      // NUNCA mexer no status. Só coordenação aprova ou nega.
      allow update: if ehCoord(escola)
                    || (signedIn() && escolaConhecida(escola)
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['nome', 'email', 'serie', 'turma', 'pedidoEm'])
                        && pedidoCoerente(sala, request.resource.data));

      allow delete: if ehCoord(escola) || (signedIn() && request.auth.uid == uid);
    }

    /* ------------------------------ auditoria ---------------------------- */
    // V-15: trilha do que a equipe faz com poder — cadastrar staff, publicar
    // calendário. Append-only de verdade: nem quem escreveu consegue alterar
    // ou apagar depois.
    //
    // Limite honesto: como quem grava é o próprio navegador de quem age, isto
    // registra a operação normal — não impede alguém de simplesmente não
    // gravar. Trilha à prova de adulteração exige Admin SDK. Serve para
    // reconstruir o que aconteceu, não para provar má-fé.
    match /schools/{escola}/auditoria/{id} {
      allow read: if ehCoord(escola);
      allow create: if ehStaff(escola)
                    && request.resource.data.keys().hasOnly(
                         ['ator', 'acao', 'alvo', 'detalhe', 'quando'])
                    && request.resource.data.ator == request.auth.token.email
                    && textoAte(request.resource.data.get('acao', ''), 60)
                    && textoAte(request.resource.data.get('alvo', ''), 300)
                    && textoAte(request.resource.data.get('detalhe', ''), 300)
                    && request.resource.data.get('quando', 0) is number;
      allow update, delete: if false;
    }

    /* ============ V-09 / A1 — pertencimento a serie e mural novo ==========
       O mural antigo (logo abaixo) mora na RAIZ do banco, em
       `{col}/{itemId}/posts/`. Esse caminho nao carrega escola nem serie, entao
       a regra nao tem o que checar e a condicao inteira vira "esta logado" —
       qualquer conta criada no mundo le todo recado de toda prova de toda
       turma. E enumeravel: da pra listar a colecao inteira.

       A correcao e mover o mural para dentro de `schools/`. Ele fica por
       SERIE (decisao de 22/09/2026) para preservar o comportamento atual: a
       3aA e a 3aB compartilham o mural de uma prova, porque a prova em si ja
       e publicada por serie, em `series/{serie}/provas`.

       Isso obriga o documento de pertencimento abaixo. A matricula aprovada
       mora em `salas/{sala}/alunos/{uid}`, e regra do Firestore nao faz
       query — sem a sala no caminho nao da pra alcanca-la. `membros/{uid}` e
       a projecao dessa matricula no nivel da serie, escrita pela coordenacao
       no mesmo lote da aprovacao.

       Por que nao amarrar em `users/{uid}.serie`: aquele campo e declarado
       pelo proprio usuario (`camposPerfil()` limita as chaves, nao os
       valores). Amarrar numa afirmacao do proprio atacante nao e controle. */

    // Escrito SO pela coordenacao, junto da aprovacao da matricula.
    // O aluno nunca cria o proprio — seria o mesmo furo da autodeclaracao.
    match /schools/{escola}/series/{serie}/membros/{uid} {
      // V-23 (25/09/2026): era `|| ehStaff(escola)` — QUALQUER professor
      // listava nome e sala de todos os aprovados de todas as séries, o mesmo
      // vazamento de escopo fechado em salas/{sala}/alunos em 05/09. Nenhuma
      // tela do professor lê isto; a regra do mural usa exists(), que não
      // depende desta permissão de leitura.
      allow read: if signedIn() && escolaConhecida(escola)
                  && (request.auth.uid == uid || ehCoord(escola));
      allow create, update: if ehCoord(escola)
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'nome', 'sala', 'desde'])
                            && request.resource.data.uid == uid;
      // LGPD art. 18: o dono tambem apaga o proprio vinculo.
      allow delete: if ehCoord(escola) || (signedIn() && request.auth.uid == uid);
    }

    function membroRef(escola, serie) {
      return /databases/$(database)/documents/schools/$(escola)/series/$(serie)/membros/$(request.auth.uid);
    }
    function ehMembroDaSerie(escola, serie) {
      return signedIn() && escolaConhecida(escola) && exists(membroRef(escola, serie));
    }

    // Isolamento por ambiente, igual ao que `ehMural` ja fazia: producao usa
    // `itens`, cada lab tem o seu. Sem isto, testar no lab3 escreveria no
    // mural de producao — `series/` nao tem sufixo de ambiente como as
    // colecoes de painel tem. Lista fechada de proposito.
    function ehItens(col) {
      return col == 'itens' || col == 'itens-lab2' || col == 'itens-lab3';
    }

    /* V-16: post do mural é texto de um aluno exibido para a turma inteira.
       Tipo e tamanho fechados (o app já corta o recado em 400), link só
       http(s), e ids sem caractere que feche atributo HTML. */
    function postOk(itemId, postId, d) {
      return idSeguro(itemId) && idSeguro(postId)
          && d.get('tipo', '') in ['link', 'texto']
          && textoAte(d.get('texto', ''), 2000)
          && textoAte(d.get('label', ''), 200)
          && textoAte(d.get('nome', ''), 60)
          && textoAte(d.get('url', ''), 1000)
          && (d.get('url', '') == '' || d.get('url', '').matches('^https?://[^\\s]+$'));
    }

    match /schools/{escola}/series/{serie}/{itensCol}/{itemId}/posts/{postId} {
      // Quem le: aluno com matricula APROVADA naquela serie, mais a
      // coordenacao (moderacao).
      //
      // Professor NAO le, e isso e um estreitamento deliberado: hoje ele le
      // por acidente, porque a regra antiga so pede `signedIn()`. Dar
      // `ehStaff()` aqui devolveria a QUALQUER professor o mural de TODAS as
      // series — que e exatamente o vazamento de escopo pelo qual o B2 foi
      // aposentado. O mural e conteudo escrito por menores; se o professor
      // precisar dele, entra depois com escopo por sala, nao por atalho.
      allow read: if ehItens(itensCol)
                  && (ehMembroDaSerie(escola, serie) || ehCoord(escola));

      allow create: if ehItens(itensCol)
                    && ehMembroDaSerie(escola, serie)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['tipo', 'url', 'label', 'texto', 'uid', 'nome', 'createdAt'])
                    && request.resource.data.createdAt is number
                    && postOk(itemId, postId, request.resource.data);

      // igual ao mural antigo: post nao se edita depois de publicado
      allow update: if false;

      // o autor apaga o proprio; a coordenacao apaga qualquer um (moderacao
      // e pedido de exclusao)
      allow delete: if ehItens(itensCol)
                    && (resource.data.uid == request.auth.uid || ehCoord(escola));
    }

    /* -------------- mural ANTIGO (raiz) — EM MIGRACAO, vai sair ---------- */
    // ESTE e o vazamento A1. Continua aberto DE PROPOSITO ate o cliente novo
    // estar no ar: fechar aqui antes disso tira o mural dos alunos sem lhes
    // dar o novo. A sequencia esta em tools/migra-mural/RUNBOOK.md — o passo
    // que fecha este bloco e o de numero 4, depois do deploy do cliente.
    //
    // Substituido por `schools/{escola}/series/{serie}/{itens*}/...` acima.
    //
    // Ganho parcial anterior da V-09: tirado o 'murals-lab' (nenhuma página usa) e
    // fechado o formato do post. A migração do mural para dentro de
    // schools/{escola}/ continua pendente e está na nota de auditoria.
    // Um nome por ambiente (ver public/app/env.js): produção usa 'murals' e
    // cada lab tem o seu, para que testar num lab não escreva no mural de
    // outro. A lista é fechada de propósito — sem ela, qualquer coleção de
    // topo com uma subcoleção `posts` viraria mural.
    function ehMural(col) {
      return col == 'murals' || col == 'murals-lab2' || col == 'murals-lab3';
    }
    match /{col}/{itemId}/posts/{postId} {
      allow read: if signedIn() && ehMural(col);
      allow create: if signedIn() && ehMural(col)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['tipo', 'url', 'label', 'texto', 'uid', 'nome', 'createdAt'])
                    && postOk(itemId, postId, request.resource.data);
      allow delete: if signedIn() && ehMural(col)
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
